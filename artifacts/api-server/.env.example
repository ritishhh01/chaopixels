# Copy this file to .env and fill in your values
# Never commit .env to version control

# Admin email address — this user gets full admin access
ADMIN_EMAIL=your-email@example.com

# PostgreSQL connection string (provided by Replit automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk secret key (from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Fal.ai API key for AI image generation (from https://fal.ai/dashboard)
FAL_API_KEY=your-fal-api-key

# Replit Object Storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-secret
